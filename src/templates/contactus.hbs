<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{pagetitle}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
     {{>loader}}
</head> 
<body>
  
<header class="main-header"  >
	{{>topbar}}   
  	{{>navbar active='contactus'}} 
</header>  
{{>pageheader image='contact-header.jpg' title=contact_us}}

 
<section class="contact_us_text ">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center ">
               <p class=" animate fadeInUp"  data-wow-duration="600ms"  data-wow-duration="600ms" data-wow-delay="100ms"> {{contact_us_text}}</p>
            </div>
        </div>
    </div>
</section>

<section class="contact-form">
    <div class="container-fluid p-0">
        <div class="row no-gutters">
            <div class="col-lg-4 c-info ">
                    <article>
                        <h4 class="c-tit"><strong>{{contact_info}}</strong></h4>
                            <ul class="list-unstyled">
                    <li class="clearfix">
                        <i class="fa fa-map"></i>
                        <address>
                            {{{address_text}}}  
                        </address>
                    </li>
                    <li class="clearfix">
                        <i class="fa fa-clock-o"></i>
                        <span class="number" dir="ltr">
                                07:00 - 18:00
                        </span>
                    </li>
                    <li class="clearfix">
                        <i class="fa fa-phone-square"></i>
                        <span class="number" dir="ltr">
                              +966114452929
                        </span>
                    </li>
                     <li class="clearfix">
                        <i class="fa fa-fax"></i>
                        <span class="number" dir="ltr">
                              +966113254789
                        </span>
                    </li>
                    <li class="clearfix">
                        <i class="fa fa-envelope"></i>
                        <a href="mailto:info@cedme.com">info@cedme.com</a>
                    </li>
                </ul>
                <nav class="d-flex">
                    <a href="">
                            <i class="fa fa-facebook"></i>
                        </a>
                        <a href="">
                            <i class="fa fa-twitter"></i>
                        </a>
                         <a href="">
                            <i class="fa fa-youtube"></i>
                        </a>
                </nav>
                 
                    </article>
        
                   </div>

            <div class="col-lg-8 c-form"> 
                    <h4 class="c-tit gold"><strong>{{message_us}}</strong></h4> 
            </div>
        </div>
    </div>
</section>




{{>map}}
{{>footer}} 
{{>bottombar}}

<script src="assets/js/script.min.js"></script> 


